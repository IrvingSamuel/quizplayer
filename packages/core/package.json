{
  "name": "@quizplayer/core",
  "version": "0.1.0",
  "description": "Interactive HTML5 video player that pauses at cue points, beeps and asks embedded quiz questions. Zero dependencies, works with any framework and any backend.",
  "license": "MIT",
  "author": "Irving Samuel",
  "homepage": "https://github.com/IrvingSamuel/quizplayer#readme",
  "repository": { "type": "git", "url": "git+https://github.com/IrvingSamuel/quizplayer.git", "directory": "packages/core" },
  "bugs": "https://github.com/IrvingSamuel/quizplayer/issues",
  "keywords": ["video", "video-player", "interactive-video", "quiz", "html5-video", "e-learning", "lms", "cue-points", "edtech", "vanilla-js"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/quizplayer.min.js",
  "jsdelivr": "./dist/quizplayer.min.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./data": { "types": "./dist/data.d.ts", "import": "./dist/data.js", "require": "./dist/data.cjs" },
    "./style.css": "./dist/quizplayer.css",
    "./global": "./dist/quizplayer.min.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
