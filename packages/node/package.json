{
  "name": "@quizplayer/server",
  "version": "0.1.0",
  "description": "Node.js backend for QuizPlayer: server-side answer validation and storage for Express, node:http and Fetch-API runtimes (Next.js, Hono, Bun, Deno).",
  "license": "MIT",
  "author": "Irving Samuel",
  "homepage": "https://github.com/IrvingSamuel/quizplayer#readme",
  "repository": { "type": "git", "url": "git+https://github.com/IrvingSamuel/quizplayer.git", "directory": "packages/node" },
  "keywords": ["quiz", "interactive-video", "express", "nextjs", "hono", "bun", "e-learning", "lms"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external @quizplayer/core",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": { "@quizplayer/core": "^0.1.0" }
}
